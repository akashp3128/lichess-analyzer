generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id
  username      String         @unique
  rating        Int?
  lastSyncedAt  DateTime       @default(now())
  createdAt     DateTime       @default(now())
  games         Game[]
  subscription  Subscription?
}

model Game {
  id            String        @id
  lichessId     String        @unique
  pgn           String
  white         String
  black         String
  result        String
  timeControl   String
  perfType      String
  opening       String?
  openingEco    String?
  playerColor   String
  playerRating  Int?
  opponentRating Int?
  playedAt      DateTime
  createdAt     DateTime      @default(now())

  userId        String
  user          User          @relation(fields: [userId], references: [id])
  analysis      Analysis?
  moves         MoveAnalysis[]

  @@index([userId])
  @@index([playedAt])
}

model Analysis {
  id              String   @id @default(cuid())
  accuracy        Float
  acpl            Float
  bestMoves       Int
  goodMoves       Int
  inaccuracies    Int
  mistakes        Int
  blunders        Int
  missedMates     Int
  timeInTrouble   Int
  avgMoveTime     Float?
  analyzedAt      DateTime @default(now())

  gameId          String   @unique
  game            Game     @relation(fields: [gameId], references: [id])
}

model MoveAnalysis {
  id              String   @id @default(cuid())
  moveNumber      Int
  move            String
  isWhite         Boolean
  evaluation      Float
  bestMove        String?
  evalLoss        Float
  classification  String
  square          String
  piece           String   @default("P")
  timeSpent       Float?
  timeRemaining   Float?
  inTimeTrouble   Boolean  @default(false)
  fen             String?

  gameId          String
  game            Game     @relation(fields: [gameId], references: [id])

  @@index([gameId])
  @@index([square])
  @@index([piece])
  @@index([classification])
}

// SaaS: Plans and Subscriptions
model Plan {
  id                   String @id @default(cuid())
  name                 String
  slug                 String @unique
  monthlyPrice         Int    // in cents
  yearlyPrice          Int    // in cents
  maxAnalysesPerMonth  Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions        Subscription[]
}

model Subscription {
  id                    String     @id @default(cuid())
  userId                String     @unique
  user                  User       @relation(fields: [userId], references: [id])
  planId                String
  plan                  Plan       @relation(fields: [planId], references: [id])
  status                String     @default("active")
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  analysesUsed          Int        @default(0)
  monthlyResetAt        DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([userId])
  @@index([planId])
}
